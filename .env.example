###############################################################################
# DevJewels Channels — env template (PRODUCTION ONLY)
# Copy → `.env` (repo root). Live values: dedicated Channels Infisical project, env=production, path `/`.
#
# Naming:
#   project = devjewels | service = channels | stage = production
#   AWS names → ${AWS_NAME_PREFIX}-production-*
#   e.g.     → devjewels-channels-production-http
###############################################################################

# --- Naming -------------------------------------------------------------------
AWS_NAME_PREFIX=devjewels-channels
# Always production — CI runs: sst deploy --stage production
SST_STAGE=production

# --- Region (same as backend) -------------------------------------------------
AWS_REGION=us-east-2

# --- Existing VPC (REQUIRED — do NOT run Channels Lambdas outside VPC) --------
# Why: RDS SG only allows 5432 from your laptop IP + 172.16.0.0/16 (VPC).
# Lambda outside VPC uses random AWS public IPs → RDS will refuse the connection
# even if RDS is "publicly accessible".
#
# Put Lambda IN this VPC (public subnets OK). Traffic → RDS uses ENI IPs in
# 172.16.0.0/16 and matches the "Only Internal" rule.
#
# AWS_SECURITY_GROUP_IDS = SG attached to the *Lambda ENI* (egress OK).
# Prefer a dedicated Lambda SG; RDS inbound already covers 172.16.0.0/16.
AWS_VPC_ID=vpc-xxxxxxxxxxxxxxxxx
AWS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxxxxxxx
AWS_SUBNET_IDS=subnet-aaaaaaaa,subnet-bbbbbbbb
#
# Shopify / storeapi HTTPS from VPC Lambda needs a NAT Gateway (Lambda never
# gets a public IP). Without NAT: RDS works, Shopify calls fail.

# --- Custom domain + existing ACM (regional cert in AWS_REGION) ---------------
CHANNELS_DOMAIN=channels.devjewels.com
AWS_ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-2:ACCOUNT_ID:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Leave empty if DNS is external (Cloudflare) — then dns:false + manual CNAME/ALIAS
AWS_ROUTE53_ZONE_ID=

CHANNELS_PUBLIC_BASE_URL=https://channels.devjewels.com
CHANNELS_OAUTH_SUCCESS_URL=https://devjewels.com/admin/channels
CHANNELS_CORS_ORIGINS=https://devjewels.com,https://www.devjewels.com,http://localhost:3000

# --- App secrets --------------------------------------------------------------
# SAME Postgres as DevJewels — schema `channels` only (role channels_app)
DATABASE_URL=postgresql://channels_app:CHANGE_ME@DB_HOST:5432/devjewels?sslmode=require&options=-csearch_path%3Dchannels
CHANNELS_SCHEMA=channels

CHANNELS_SERVICE_TOKEN=change-me
# Optional; defaults to CHANNELS_SERVICE_TOKEN when unset
# CHANNELS_INVITE_SIGNING_SECRET=change-me-invite-only
DEVJEWELS_API_BASE_URL=https://storeapi.devjewels.com
CHANNELS_ENQUEUE_SKELETON_ON_UNMAPPED=0

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders
# SHOPIFY_OAUTH_REDIRECT_URI=https://channels.devjewels.com/api/shopify/auth/callback

# CHANNELS_DASHBOARD_PASSWORD=

# --- Local-only (blank on AWS) ------------------------------------------------
INVENTORY_SYNC_QUEUE_URL=
ORDER_PROCESSING_QUEUE_URL=
PRODUCT_SYNC_QUEUE_URL=
PRICE_SYNC_QUEUE_URL=
# CHANNELS_VAULT_DIR=
# CHANNELS_SECRET_shopify_local=
