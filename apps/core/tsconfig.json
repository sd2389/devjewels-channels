{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@devjewels-channels/core/security/vault": ["./src/security/vault.ts"],
      "@devjewels-channels/shopify": ["../shopify/src/index.ts"],
      "@devjewels-channels/shopify/auth": ["../shopify/src/auth.ts"],
      "@devjewels-channels/shopify/webhooks": ["../shopify/src/webhooks.ts"],
      "@devjewels-channels/shopify/auth-route": ["../shopify/app/api/shopify/auth/route.ts"],
      "@devjewels-channels/shopify/webhooks-route": ["../shopify/app/api/shopify/webhooks/route.ts"],
      "@devjewels-channels/woocommerce": ["../woocommerce/src/index.ts"],
      "@devjewels-channels/woocommerce/webhooks-route": ["../woocommerce/app/api/woocommerce/webhooks/route.ts"]
    },
    "allowJs": true,
    "incremental": true
  },
  "include": ["src/**/*", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.selfcheck.ts"]
}
