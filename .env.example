# Shared Postgres — SAME database as Dev Jewels (`devjewels`), schema `channels` only.
# Role channels_app must NOT access public.* SoT tables.
# Example: postgresql://channels_app:CHANGE_ME@localhost:5432/devjewels
DATABASE_URL=postgresql://channels_app:CHANGE_ME@localhost:5432/devjewels
CHANNELS_SCHEMA=channels

# Service auth: Django → Channels event ingest / Channels → Django channels_api
CHANNELS_SERVICE_TOKEN=change-me-local-only

# Django SoT base (internal HTTP only — never query public tables from Channels)
DEVJEWELS_API_BASE_URL=http://localhost:8000

# SQS queue URLs (set by SST link in deploy; leave blank for local Next-only → in-memory enqueue)
INVENTORY_SYNC_QUEUE_URL=
ORDER_PROCESSING_QUEUE_URL=
PRODUCT_SYNC_QUEUE_URL=
PRICE_SYNC_QUEUE_URL=

# When no variant_mapping rows exist, enqueue a Shopify pipeline skeleton job (local smoke).
# Set 0 once real mappings exist (production default should be 0).
CHANNELS_ENQUEUE_SKELETON_ON_UNMAPPED=1

# Shopify Admin API / OAuth
# Preferred: paste Partner Client ID + Secret once in the Channels dashboard
# (stored in vault). These env keys are optional fallback only.
# Redirect defaults to http://localhost:3100/api/shopify/auth/callback when unset.
# Copy this file to repo-root `.env` (same directory as package.json), NOT apps/core/.
# After any env change: restart `npm run dev` (Next only reads env at process start).
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01
# Full scope set so merchants are not re-prompted on upgrade
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders
# Optional. If unset: {CHANNELS_PUBLIC_BASE_URL}/api/shopify/auth/callback, else localhost:3100
# SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:3100/api/shopify/auth/callback
# Public URL of this Channels host (webhooks + OAuth redirect default)
# Local: http://localhost:3100 — use a tunnel URL when Shopify must reach your machine
CHANNELS_PUBLIC_BASE_URL=http://localhost:3100

# Optional: protect dashboard APIs when set (cookie login later). Leave blank for local staff UX.
# CHANNELS_DASHBOARD_PASSWORD=

# Vault dir for staff-pasted Shopify tokens (default: <repo>/.data/secrets — gitignored)
# CHANNELS_VAULT_DIR=

# Legacy env secret refs (prefer Connect UI → vault: refs instead):
# CHANNELS_SECRET_shopify_local={"accessToken":"shpat_xxx","shopDomain":"your-store.myshopify.com"}
CHANNELS_SECRET_shopify_local=
